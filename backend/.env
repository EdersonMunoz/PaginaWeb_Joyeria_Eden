# Datos privados de ESTE computador. Cada integrante tiene el suyo y NO se sube a GitHub.
# Cuando ya esté instalado Oracle 21c, cambiar estos valores por los reales.
PUERTO=4000
ORACLE_USUARIO=eden
ORACLE_CLAVE=cambia_esta_clave
# En Oracle 21c XE el servicio suele llamarse XEPDB1 (se puede confirmar en SQL Developer)
ORACLE_CONEXION=localhost:1521/XEPDB1
