# Copien este archivo como ".env" y pongan los datos de su Oracle.
# El archivo .env NO se sube a GitHub (cada uno tiene su propia clave).

# Usuario y contraseña del esquema donde corrieron db/01_tablas.sql
DB_USUARIO=eden
DB_CLAVE=eden123

# host:puerto/servicio
#   Oracle en Docker (el contenedor eden-oracle) ... localhost:1522/FREEPDB1
#   Oracle XE 21c instalado en Windows ........... localhost:1521/XEPDB1
DB_CONEXION=localhost:1522/FREEPDB1

# Puerto del backend y direcciones del frontend que pueden usarlo (separadas por coma)
PUERTO=3001
FRONTEND_URL=http://localhost:5173,http://localhost:4173
