# Copien este archivo como ".env" y pongan los datos de la base.
# El archivo .env NO se sube a GitHub (tiene claves).

# ---------------------------------------------------------------
# Base de datos compartida en Oracle Cloud (Autonomous Database)
# ---------------------------------------------------------------
DB_USUARIO=eden
DB_CLAVE=la_clave_del_usuario_eden

# Nombre del servicio que está en el archivo tnsnames.ora del wallet
# (para esta página se usa el que termina en _tp)
DB_CONEXION=eden_tp

# Carpeta donde descomprimieron el wallet (zip descargado de Oracle Cloud)
# y la contraseña que le pusieron al descargarlo. Usen / en la ruta.
DB_WALLET=C:/Users/SuUsuario/wallet_eden
DB_WALLET_CLAVE=la_clave_del_wallet

# Para usar un Oracle local en vez de la nube: dejen DB_WALLET vacío y pongan
#   Oracle en Docker ............. DB_CONEXION=localhost:1522/FREEPDB1
#   Oracle XE 21c en Windows ..... DB_CONEXION=localhost:1521/XEPDB1

# ---------------------------------------------------------------
# Fotos: bucket "eden-fotos" de Oracle Cloud (Object Storage)
# ---------------------------------------------------------------
# URL de la Pre-Authenticated Request (permiso para SUBIR fotos). Es secreta.
FOTOS_PAR_URL=https://objectstorage.REGION.oraclecloud.com/p/TOKEN/n/NAMESPACE/b/eden-fotos/o/

# ---------------------------------------------------------------
# Puerto del backend y direcciones del frontend que pueden usarlo (separadas por coma)
PUERTO=3001
FRONTEND_URL=http://localhost:5173,http://localhost:4173
