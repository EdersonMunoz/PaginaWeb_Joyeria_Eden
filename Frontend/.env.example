# Copia este archivo como .env y ajusta los valores.

# Dirección del backend (opcional; por defecto http://localhost:3001)
# VITE_API_URL=http://localhost:3001

# Sprint 4 · HE4-HU1: botón de WhatsApp.
# Número del asesor: código de país + número, solo dígitos (ejemplo de Colombia: 573001234567).
VITE_WHATSAPP_NUMERO=
# Mensaje que aparece escrito al abrir el chat (opcional).
VITE_WHATSAPP_MENSAJE=Hola, necesito ayuda con la tienda EDEN.
